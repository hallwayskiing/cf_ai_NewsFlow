{
  "name": "newsflow-ai",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-03",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS"
  },
  // 1. Workflows
  "workflows": [
    {
      "name": "news-workflow",
      "binding": "MY_WORKFLOW",
      "class_name": "NewsWorkflow"
    }
  ],
  // 2. Workers AI
  "ai": {
    "binding": "AI"
  },
  // 3. Vectorize
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "news-index"
    }
  ],
  // 4. KV Storage
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      "id": "510b281c8d13458da7a3918763ab81a1"
    }
  ],
  // 5. Cron Triggers
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}